<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="15" styleClass="vbox-container" xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.clinicmanagementsystem.controller.AppointmentController">
    <HBox spacing="15">
        <VBox spacing="10" styleClass="card" HBox.hgrow="ALWAYS">
            <Label text="Schedule Appointment" style="-fx-font-weight: bold;"/>
            <ComboBox fx:id="appPatientBox" promptText="Select Patient" maxWidth="Infinity"/>
            <ComboBox fx:id="appDoctorBox" promptText="Select Doctor" maxWidth="Infinity"/>
            <HBox spacing="10">
                <DatePicker fx:id="appDatePicker" promptText="Date" HBox.hgrow="ALWAYS"/>
                <ComboBox fx:id="appTimeBox" promptText="Time" prefWidth="120"/>
            </HBox>
            <HBox spacing="10">
                <Button text="Book" onAction="#handleAddAppointment" style="-fx-background-color: #2ecc71;"/>
                <Button text="Clear Form" onAction="#handleClearAppointment" style="-fx-background-color: #95a5a6;"/>
                <Button text="Cancel Selected" onAction="#handleDeleteAppointment" style="-fx-background-color: #e74c3c;"/>
            </HBox>
        </VBox>
    </HBox>
    <TableView fx:id="appTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="appPatientCol" text="Patient"/>
            <TableColumn fx:id="appDoctorCol" text="Doctor"/>
            <TableColumn fx:id="appTimeCol" text="Date &amp; Time"/>
        </columns>
        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
    </TableView>
</VBox>
