<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="15" styleClass="vbox-container" xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.clinicmanagementsystem.controller.DoctorController">
    <HBox spacing="15">
        <VBox spacing="10" styleClass="card" HBox.hgrow="ALWAYS">
            <Label text="Doctor Directory" style="-fx-font-weight: bold;"/>
            <TextField fx:id="dNameField" promptText="Doctor Name"/>
            <TextField fx:id="dSpecField" promptText="Specialty"/>
            <HBox spacing="10">
                <Button text="Save New" onAction="#handleAddDoctor" styleClass="button"/>
                <Button text="Update Selected" onAction="#handleUpdateDoctor" styleClass="button-secondary"/>
                <Button text="Clear/New" onAction="#handleClearDoctor" style="-fx-background-color: #95a5a6;"/>
                <Button text="Delete" onAction="#handleDeleteDoctor" style="-fx-background-color: #e74c3c;"/>
            </HBox>
        </VBox>
    </HBox>
    <TableView fx:id="dTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="dNameCol" text="Name" prefWidth="250"/>
            <TableColumn fx:id="dSpecCol" text="Specialty" prefWidth="250"/>
        </columns>
        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
    </TableView>
</VBox>
